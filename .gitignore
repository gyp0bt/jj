# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
jj-db/node_modules
jj-db/.pnp
jj-db/.pnp.*
jj-db/.yarn/*
!jj-db/.yarn/patches
!jj-db/.yarn/plugins
!jj-db/.yarn/releases
!jj-db/.yarn/versions

# testing
jj-db/coverage

# next.js
jj-db/.next/
jj-db/out/

# production
jj-db/build

# misc
jj-db/.DS_Store
*.pem

# debug
jj-db/npm-debug.log*
jj-db/yarn-debug.log*
jj-db/yarn-error.log*
jj-db/.pnpm-debug.log*

# env files (can opt-in for committing if needed)
jj-db/.env*

# vercel
jj-db/.vercel

# typescript
*.tsbuildinfo
jj-db/next-env.d.ts

*storybook.log

# SQLite database
jj-db/data/

# Python-generated files
__pycache__/
*.py[oc]
jj/build/
jj/dist/
jj/wheels/
*.egg-info

# Virtual environments
jj/.venv

# Project-specific data (generated at runtime)
jj/.jj/config/
jj/.jj/storage/

# Test-generated .jj directories
**/.jj/storage/
